# Deployed to /etc/caddy/Caddyfile on the VPS.
#
# Requires the rate_limit module. The official Caddy binary can add it in place:
#   sudo caddy add-package github.com/mholt/caddy-ratelimit
#   sudo systemctl restart caddy
# See BOOTSTRAP.md.

api.tesserae.ink {
	encode zstd gzip

	# Global body cap: the largest legitimate request is a template submission
	# (doc ≤256KB + preview PNG ≤1MB, which base64 inflates to ~1.4MB). Every
	# other endpoint takes tiny bodies, and submissions are rate-limited to
	# 5/hour per IP below, so the headroom here isn't a DoS lever.
	request_body {
		max_size 4MB
	}

	# Per-IP rate limit: 60 requests/minute, keyed on the client address, plus
	# a tighter zone on template submissions (rare, human-scale events) so a
	# scripted flood can't bury the review channel.
	rate_limit {
		zone perip {
			key {remote_host}
			events 60
			window 1m
		}
		zone tpl_submit {
			match {
				method POST
				path /templates/submit
			}
			key {remote_host}
			events 5
			window 1h
		}
		zone tpl_report {
			match {
				method POST
				path /templates/*/report
			}
			key {remote_host}
			events 10
			window 1h
		}
		# Flash completion reports fan out to a webhook (a physical bell in the
		# reference deployment); a real person flashes a handful of boards an
		# hour at most, so a scripted loop cannot keep it ringing.
		zone flash_events {
			match {
				method POST
				path /flash/events
			}
			key {remote_host}
			events 12
			window 1h
		}
		# Cloud waitlist sign-ups: one person joins once, so a handful an hour
		# per address is plenty and a script cannot pad the list.
		zone cloud_waitlist {
			match {
				method POST
				path /cloud/waitlist*
			}
			key {remote_host}
			events 5
			window 1h
		}
	}

	reverse_proxy 127.0.0.1:8000

	# Access log deliberately strips IP and User-Agent. What remains: ts, method,
	# uri, status, size, duration. Nothing that identifies a caller is written.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				resp_headers delete
				bytes_read delete
				user_id delete
			}
		}
	}
}
